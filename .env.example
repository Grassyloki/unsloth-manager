# Copy to `local.env` and edit. Values here are read at startup; a real
# environment variable of the same name always wins, so a systemd unit or a
# one-off `UNSLOTH_MGR_X=y python unsloth_manager.py ...` still overrides.
#
# Every setting is optional -- the defaults in unsloth_manager.py are chosen
# to work on a fresh machine. See "Configuration" in the README for the full
# table and what each one does.

# --- the two you are most likely to need -----------------------------------
# Hostname printed in the URLs clients connect to. Default: this machine's
# hostname, which is right only if that is how clients reach it.
#UNSLOTH_MGR_PUBLIC_HOST=gpubox.example.com

# Hugging Face cache holding the weights. Default: the service account's
# ~/.cache/huggingface. Set it if the models live on another volume.
#UNSLOTH_MGR_HF_HOME=/srv/models/huggingface

# --- accounts and paths ----------------------------------------------------
#UNSLOTH_MGR_USER=unsloth
#UNSLOTH_MGR_STATE_DIR=/root/.unsloth-pids
#UNSLOTH_MGR_LOG_DIR=/root/.unsloth-logs
#UNSLOTH_MGR_STUDIO_HOME=            # leave unset; see the symlink gotcha
#UNSLOTH_MGR_STUDIO_DB=
#UNSLOTH_MGR_STUDIO_ASSETS=

# --- ports and limits ------------------------------------------------------
#UNSLOTH_MGR_BASE_PORT=10001
#UNSLOTH_MGR_MAX_INSTANCES=8
#UNSLOTH_MGR_GROUP_SLOTS=10
#UNSLOTH_MGR_BIND_HOST=0.0.0.0
#UNSLOTH_MGR_PUBLIC_SCHEME=http

# --- behaviour -------------------------------------------------------------
#UNSLOTH_MGR_BIN=unsloth
#UNSLOTH_MGR_API_KEY=
#UNSLOTH_MGR_STOP_TIMEOUT=30
#UNSLOTH_MGR_LOAD_TIMEOUT=900
#UNSLOTH_MGR_LOG_KEEP=3
#UNSLOTH_MGR_PER_GPU_VRAM_GB=
