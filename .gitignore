# Per-machine settings. Copy local.env.example to local.env; never commit it.
# (local.env.example itself matches neither pattern, so it is tracked.)
local.env
*.env
# api_tester.sh endpoints, which carry API keys
.api_tester.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Runtime state and output, in case anyone points STATE_DIR/LOG_DIR here
*.log
*.log.[0-9]*
state.json
groups.json
tokens.json
*.json.tmp
bench-*.json

# Editors and OS cruft
.vscode/
.idea/
*.swp
.DS_Store
